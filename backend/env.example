# Kuro backend environment template
# Copy to backend/.env (never commit real secrets)

# Required
GROQ_API_KEY=
GEMINI_API_KEY=
PINECONE_API_KEY=
MONGODB_URI=mongodb://localhost:27017/chatbot_db

# Pinecone / embeddings (clean 768-d index)
PINECONE_INDEX_NAME=kuro-memory
KURO_EMBEDDING_MODEL=models/gemini-embedding-001
KURO_EMBEDDING_DIMENSION=768
KURO_EMBEDDING_METRIC=cosine

# Groq chat models (production)
KURO_PRIMARY_MODEL=openai/gpt-oss-120b
KURO_FALLBACK_MODEL=openai/gpt-oss-20b
KURO_FAST_MODEL=openai/gpt-oss-20b

# App
ENVIRONMENT=development
DEBUG=false
FRONTEND_URL=http://localhost:3000
PORT=8000

# Optional
# GOOGLE_API_KEY=          # alias for GEMINI_API_KEY
# OPENROUTER_API_KEY=      # not used by live ChatManagerV3
# ADMIN_API_KEY=
# SENTRY_DSN=
# DISABLE_MEMORY_INIT=1    # tests only
